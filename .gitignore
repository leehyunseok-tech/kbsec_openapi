# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 실제 API 키/시크릿이 담긴 로컬 설정 파일 (config.example.py는 커밋 대상)
config/config.py

# 런타임 동적 설정/예약/쿨다운 기록, 체결 로그 (개인 거래 데이터)
config/data/*.json
logs/

# 통합 런처 run-kbsec-openapi — 리포에 커밋하지 않고 install-project.* 실행 시
# OS에 맞게 생성된다(.sh는 heredoc, .bat는 base64 디코드). 확장자 없는 링크 포함.
/run-kbsec-openapi
/run-kbsec-openapi.sh
/run-kbsec-openapi.bat

# 클라이언트별 더블클릭 실행 숏컷 — 위와 동일하게 install-project.*가 생성하는
# 로컬 산출물(리포에 커밋하지 않음).
/웹-실행.bat
/웹-실행.sh
/터미널-실행.bat
/터미널-실행.sh
/텔레그램-실행.bat
/텔레그램-실행.sh

# 로컬 Claude Code 권한/설정 (개인 머신 전용, 팀 공유 대상 아님)
.claude/
.idea/
docs/prompt/